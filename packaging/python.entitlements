<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened-runtime entitlements for the PyInstaller-built agent-farm-core.
	     ctypes/libffi (psutil uses ctypes on macOS) need executable memory. Library
	     validation stays on: every dylib and extension module in the bundle is signed
	     with the same identity by scripts/sign_app.sh. -->
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
</dict>
</plist>
